#!/usr/bin/env bash

fails=0
tests=0
skips=0

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
. "$REPO_ROOT/bin/test/capture.bash"

# Portable temp-dir creation (GNU --tmpdir is unavailable on BSD mktemp).
_mk_tmpdir() { # $1 = name prefix
	mktemp -d "${TMPDIR:-/tmp}/$1.XXXXXX"
}

TEST_DIR=$(_mk_tmpdir rm-safe-test)
REAL_RM=$([ -x /bin/rm ] && echo /bin/rm || command -v rm || echo rm)
trap '"$REAL_RM" -rf "$TEST_DIR"' EXIT

HOME_DIR="$TEST_DIR/home"
XDG_DIR="$TEST_DIR/xdg"
WORK_DIR="$TEST_DIR/work"
BIN_DIR="$TEST_DIR/bin"
BASH_DIR="$(dirname "$(command -v bash)")"
HOST_PATH="$PATH"
PATH_BASE="$BIN_DIR:$BASH_DIR:$REPO_ROOT/bin:$HOST_PATH"

mkdir -p "$HOME_DIR" "$XDG_DIR" "$WORK_DIR" "$BIN_DIR"

# Select the implementation under test. RM_SAFE_BIN (absolute path) wins;
# default is the luajit impl. We expose it as $BIN_DIR/rm-safe, and $BIN_DIR
# is first on PATH_BASE, so every `rm-safe` invocation hits the selected impl.
RM_SAFE_BIN=${RM_SAFE_BIN:-"$REPO_ROOT/bin/rm-safe"}
if [[ ! -x $RM_SAFE_BIN ]]; then
	echo "rm-safe_test: RM_SAFE_BIN=$RM_SAFE_BIN is not executable" >&2
	exit 2
fi
ln -sf -- "$RM_SAFE_BIN" "$BIN_DIR/rm-safe"

cat >"$BIN_DIR/gio" <<'GIO'
#!/bin/sh
exit 1
GIO
chmod +x "$BIN_DIR/gio"

cat >"$BIN_DIR/trash-put" <<'TRASHPUT'
#!/bin/sh
exit 1
TRASHPUT
chmod +x "$BIN_DIR/trash-put"

if [[ $(uname) == "Darwin" ]]; then
	TRASH_BASE="$HOME_DIR/.Trash"
else
	TRASH_BASE="$XDG_DIR/Trash"
fi

TRASH_FILES="$TRASH_BASE/files"
TRASH_INFO="$TRASH_BASE/info"
LOG_DIR="$TRASH_BASE/rm-safe-log"

reset_trash() {
	mkdir -p "$TRASH_FILES" "$TRASH_INFO" "$LOG_DIR"
	find "$TRASH_FILES" -mindepth 1 -maxdepth 1 -exec "$REAL_RM" -rf {} + 2>/dev/null || true
	find "$TRASH_INFO" -mindepth 1 -maxdepth 1 -exec "$REAL_RM" -rf {} + 2>/dev/null || true
	find "$LOG_DIR" -mindepth 1 -maxdepth 1 -exec "$REAL_RM" -rf {} + 2>/dev/null || true
}

# Concatenate all log fragments in temporal order (filenames start with
# an epoch-ns timestamp, so lex sort == time sort). Reproduces what the
# old single-file log used to give us in one `cat`.
read_all_logs() {
	if [[ -d "$LOG_DIR" ]]; then
		# NUL-delimited: fragment names keep spaces when printable-binary is absent.
		find "$LOG_DIR" -mindepth 1 -maxdepth 1 -type f -print0 | sort -z | xargs -0 cat 2>/dev/null
	fi
}

skip_test() {
	local name=$1
	local reason=$2
	echo "SKIP $name: $reason" >&2
	((skips++))
}

path_without_commands() {
	local input_path=$1
	shift
	local filtered=""
	local part cmd skip_part
	IFS=: read -r -a parts <<<"$input_path"
	for part in "${parts[@]}"; do
		[[ -z $part ]] && continue
		skip_part=false
		for cmd in "$@"; do
			if [[ -x $part/$cmd ]]; then
				skip_part=true
				break
			fi
		done
		[[ $skip_part == true ]] && continue
		if [[ -z $filtered ]]; then
			filtered=$part
		else
			filtered="$filtered:$part"
		fi
	done
	echo "$filtered"
}

build_path_with_fzf_only() {
	local fzf_source=$1
	local overlay_dir="$TEST_DIR/path-overlay"
	local cmd cmd_path
	mkdir -p "$overlay_dir"

	# Use symlinks only; never copy binaries into the overlay PATH.
	ln -sf -- "$fzf_source" "$overlay_dir/fzf"
	for cmd in bash luajit expect; do
		cmd_path=$(PATH="$PATH_BASE" command -v "$cmd" || true)
		[[ -n $cmd_path ]] && ln -sf -- "$cmd_path" "$overlay_dir/$cmd"
	done
	# Ensure core POSIX tools resolve to real system binaries, not any ~/bin wrapper
	# scripts that shadow them (e.g. ~/bin/date, ~/bin/tac).  Search known safe
	# locations in priority order; skip if none found.
	for cmd in date awk sed; do
		for sys_dir in /bin /usr/bin; do
			if [[ -x "$sys_dir/$cmd" ]]; then
				ln -sf -- "$sys_dir/$cmd" "$overlay_dir/$cmd"
				break
			fi
		done
	done
	if [[ ! -L $overlay_dir/fzf ]]; then
		return 1
	fi

	local host_filtered
	host_filtered=$(path_without_commands "$HOST_PATH" gum fzf)
	echo "$overlay_dir:$BIN_DIR:$REPO_ROOT/bin:$host_filtered"
}

run_cmd() {
	local out err rc
	capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$PATH_BASE" rm-safe "$@"
	RM_OUT="$out"
	RM_ERR="$err"
	RM_RC="$rc"
}

# Like run_cmd but with an explicit PATH, for exercising degraded environments.
run_cmd_with_path() {
	local path_override=$1; shift
	local out err rc
	capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$path_override" rm-safe "$@"
	RM_OUT="$out"
	RM_ERR="$err"
	RM_RC="$rc"
}

run_cmd_no_tty() {
	local out err rc
	capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$PATH_BASE" bash -c 'rm-safe "$@"' _ "$@" </dev/null
	RM_OUT="$out"
	RM_ERR="$err"
	RM_RC="$rc"
}

run_cmd_expect() {
	local path_override=$1
	local cmd_args=$2
	local out err rc
	capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$path_override" expect -c "
		set timeout 5
		spawn -noecho rm-safe $cmd_args
		after 200
		send \"\\r\"
		set rc 1
		expect {
			eof { catch {lassign [wait] _p _s _e rc} }
			timeout { catch {exec kill -9 [exp_pid]}; catch {wait}; set rc 124 }
		}
		exit \$rc
	"
	RM_OUT="$out"
	RM_ERR="$err"
	RM_RC="$rc"
}

# Test 0: the selected impl is the one being exercised
((tests++))
if [[ "$(readlink "$BIN_DIR/rm-safe")" == "$RM_SAFE_BIN" ]]; then
	echo "OK exercising impl: $RM_SAFE_BIN"
else
	echo "FAIL impl selection wrong" >&2
	((fails++))
fi

# Test 1: --undo restores last TRASH_MANUAL and logs TRASH_RESTORE
reset_trash
((tests++))
echo "hello" >"$WORK_DIR/file1"
run_cmd "$WORK_DIR/file1"
if [[ $RM_RC -ne 0 ]]; then
	echo "FAIL rm-safe failed to trash file" >&2
	printf '%s\n' "$RM_ERR" >&2
	((fails++))
else
	line=$(read_all_logs | awk -F'\t' '$3=="TRASH_MANUAL"{line=$0} END{print line}')
	if [[ -z $line ]]; then
		echo "FAIL TRASH_MANUAL log entry missing" >&2
		((fails++))
	else
		IFS=$'\t' read -r ts user action original trash_path details <<<"$line"
		run_cmd --undo
		if [[ $RM_RC -eq 0 && -e $original && ! -e $trash_path ]] && printf '%s' "$RM_ERR" | grep -F "Path $trash_path restored to $original successfully." >/dev/null; then
			restore_line=$(read_all_logs | tail -n 1)
			IFS=$'\t' read -r rts ruser raction rsrc rdest rdetails <<<"$restore_line"
			if [[ $raction == "TRASH_RESTORE" && $rsrc == "$trash_path" && $rdest == "$original" ]]; then
				echo "OK --undo restores last TRASH_MANUAL"
			else
				echo "FAIL TRASH_RESTORE log entry incorrect" >&2
				((fails++))
			fi
		else
			echo "FAIL --undo did not restore file or message missing" >&2
			printf '%s\n' "$RM_ERR" >&2
			((fails++))
		fi
	fi
fi

# Test 2: Bash undo ignores an inherited find shell function.
# The implementation receives a synthetic HOME in this suite. An exported
# function that resolves find through $HOME must not hide its log fragments.
reset_trash
((tests++))
hostile_find_env="$TEST_DIR/hostile-find.bashenv"
cat >"$hostile_find_env" <<'EOF'
find() { return 127; }
EOF
echo "find-safe" >"$WORK_DIR/find-safe"
out=""; err=""; rc=0
capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$PATH_BASE" \
	BASH_ENV="$hostile_find_env" "$REPO_ROOT/bin/rm-safe.bash" "$WORK_DIR/find-safe"
hostile_find_trash_rc=$rc
capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$PATH_BASE" \
	BASH_ENV="$hostile_find_env" "$REPO_ROOT/bin/rm-safe.bash" --undo
hostile_find_undo_rc=$rc
if [[ $hostile_find_trash_rc -eq 0 && $hostile_find_undo_rc -eq 0 && -f "$WORK_DIR/find-safe" ]]; then
	echo "OK bash undo ignores an inherited find function"
else
	echo "FAIL bash undo obeyed an inherited find function" >&2
	printf '%s\n' "$err" >&2
	((fails++))
fi

# Test 3: --undo -2 restores the second-to-last TRASH_MANUAL
reset_trash
((tests++))
echo "a" >"$WORK_DIR/fileA"
echo "b" >"$WORK_DIR/fileB"
run_cmd "$WORK_DIR/fileA"
run_cmd "$WORK_DIR/fileB"
run_cmd --undo -2
if [[ $RM_RC -eq 0 && -e "$WORK_DIR/fileA" && ! -e "$WORK_DIR/fileB" ]]; then
	echo "OK --undo -2 restores second-to-last entry"
else
	echo "FAIL --undo -2 did not restore expected file" >&2
	printf '%s\n' "$RM_ERR" >&2
	((fails++))
fi

# Test 3: --undo-picker falls back to --undo in non-interactive mode (with warning)
reset_trash
((tests++))
echo "c" >"$WORK_DIR/fileC"
run_cmd "$WORK_DIR/fileC"
run_cmd_no_tty --undo-picker
if [[ $RM_RC -eq 0 && -e "$WORK_DIR/fileC" ]] && printf '%s' "$RM_ERR" | grep -F "falling back to --undo" >/dev/null; then
	echo "OK --undo-picker falls back to --undo when non-interactive"
else
	echo "FAIL --undo-picker fallback failed" >&2
	printf '%s\n' "$RM_ERR" >&2
	((fails++))
fi

# Test 4: --undo-picker uses gum in interactive mode
reset_trash
((tests++))
if ! PATH="$PATH_BASE" command -v gum >/dev/null 2>&1; then
	skip_test "--undo-picker gum" "gum not installed"
else
	echo "d" >"$WORK_DIR/fileD"
	run_cmd "$WORK_DIR/fileD"
	run_cmd_expect "$PATH_BASE" "--undo-picker"
	if [[ $RM_RC -eq 0 && -e "$WORK_DIR/fileD" ]]; then
		echo "OK --undo-picker restores via gum"
	else
		echo "FAIL --undo-picker gum restore failed" >&2
		printf '%s\n' "$RM_OUT" >&2
		printf '%s\n' "$RM_ERR" >&2
		((fails++))
	fi
fi

# Test 5: --undo-picker falls back to fzf when gum is missing
reset_trash
((tests++))
fzf_path=$(PATH="$PATH_BASE" command -v fzf || true)
if [[ -z $fzf_path ]]; then
	skip_test "--undo-picker fzf" "fzf not installed"
else
	if ! PATH_FZF=$(build_path_with_fzf_only "$fzf_path"); then
		echo "FAIL --undo-picker fzf setup failed: overlay path build failed" >&2
		((fails++))
	elif [[ ! -L "$TEST_DIR/path-overlay/fzf" ]]; then
		echo "FAIL --undo-picker fzf setup failed: fzf overlay entry is not a symlink" >&2
		((fails++))
	elif PATH="$PATH_FZF" command -v gum >/dev/null 2>&1; then
		echo "FAIL --undo-picker fzf setup failed: gum still visible in PATH" >&2
		((fails++))
	elif ! PATH="$PATH_FZF" command -v fzf >/dev/null 2>&1; then
		echo "FAIL --undo-picker fzf setup failed: fzf missing from PATH overlay" >&2
		((fails++))
	else
		echo "e" >"$WORK_DIR/fileE"
		run_cmd "$WORK_DIR/fileE"
		run_cmd_expect "$PATH_FZF" "--undo-picker"
		if [[ $RM_RC -eq 0 && -e "$WORK_DIR/fileE" ]] && printf '%s\n%s' "$RM_ERR" "$RM_OUT" | grep -F "gum not found; trying fzf" >/dev/null; then
			echo "OK --undo-picker restores via fzf"
		else
			echo "FAIL --undo-picker fzf restore failed" >&2
			printf '%s\n' "$RM_ERR" >&2
			((fails++))
		fi
	fi
fi

# Test: bash 3.2 emits a suppressible degraded-setup warning
((tests++))
B32=""
for c in /bin/bash; do v=$("$c" -c 'echo ${BASH_VERSINFO[0]}' 2>/dev/null); [[ $v == 3 ]] && B32=$c; done
if [[ -z $B32 ]]; then
	skip_test "bash32 warning" "no bash 3.x present"
else
	warn_out=$(env HOME="$HOME_DIR" PATH="$PATH_BASE" "$B32" "$REPO_ROOT/bin/rm-safe.bash" --about 2>&1 >/dev/null)
	quiet_out=$(env HOME="$HOME_DIR" PATH="$PATH_BASE" RM_SAFE_QUIET=1 "$B32" "$REPO_ROOT/bin/rm-safe.bash" --about 2>&1 >/dev/null)
	if printf '%s' "$warn_out" | grep -qi "running under bash" && ! printf '%s' "$quiet_out" | grep -qi "running under bash"; then
		echo "OK bash 3.2 warning emitted and suppressible"
	else
		echo "FAIL bash 3.2 warning behavior wrong" >&2
		((fails++))
	fi
fi

# Test: bash impl prefers a g-prefixed tool when available
((tests++))
gshim="$TEST_DIR/gshim"; mkdir -p "$gshim"
cat >"$gshim/gmktemp" <<EOF
#!/bin/sh
echo "GMKTEMP_USED" >>"$TEST_DIR/gmktemp.trace"
exec mktemp "\$@"
EOF
chmod +x "$gshim/gmktemp"
env HOME="$HOME_DIR" PATH="$gshim:$PATH_BASE" "$REPO_ROOT/bin/rm-safe.bash" --test >/dev/null 2>&1 || true
if [[ -f "$TEST_DIR/gmktemp.trace" ]]; then
	echo "OK bash impl used g-prefixed gmktemp when present"
else
	echo "FAIL g-prefixed tool not preferred" >&2
	((fails++))
fi

# Test: undo survives a missing `printable-binary`.
# Regression guard. The fragment filename is built from pb_encode(original_path),
# which shells out to printable-binary to make the path filesystem-safe (/ -> ⁄).
# When that tool was absent the fallback returned the path UNCHANGED, so the
# fragment name still contained slashes, the write landed in a nonexistent
# directory and failed silently -- the file was trashed but no log fragment
# existed, so --undo could never restore it. printable-binary is not a
# documented dependency, so this was the default experience for most installs.
reset_trash
((tests++))
echo "nopb-payload" >"$WORK_DIR/nopb.txt"
NOPB_HOST_PATH=$(path_without_commands "$HOST_PATH" printable-binary)
NOPB_PATH="$BIN_DIR:$BASH_DIR:$REPO_ROOT/bin:$NOPB_HOST_PATH"
if env PATH="$NOPB_PATH" command -v printable-binary >/dev/null 2>&1; then
	skip_test "missing printable-binary" "could not construct a PATH without printable-binary"
else
	run_cmd_with_path "$NOPB_PATH" "$WORK_DIR/nopb.txt"
	nopb_rc=$RM_RC
	nopb_line=$(read_all_logs | awk -F'\t' '$3=="TRASH_MANUAL"{line=$0} END{print line}')
	run_cmd_with_path "$NOPB_PATH" --undo
	if [[ $nopb_rc -eq 0 && -n $nopb_line && -f "$WORK_DIR/nopb.txt" \
		&& $(cat "$WORK_DIR/nopb.txt") == "nopb-payload" ]]; then
		echo "OK undo works without printable-binary installed"
	else
		echo "FAIL undo broken without printable-binary (trash rc=$nopb_rc, log entry: ${nopb_line:-<none>})" >&2
		((fails++))
	fi
fi


# Test: concurrent invocations never collide in the Trash.
# Regression guard for an inbox report (2026-11-08): 8 parallel `rm` calls on
# same-basename paths intermittently failed with "Failed to move ... to trash".
# Root cause was check-then-act naming (probe for a free Trash name, THEN
# move), so racing processes picked the same name: a file rename silently
# clobbered another process's trashed file, and a directory move either failed
# or nested inside the other entry. Invariants checked per round, regardless of
# interleaving: every call exits 0, every payload survives exactly once as its
# own top-level Trash entry, and every entry has a .trashinfo naming its origin.
# $1 = label, $2 = parent dir for the source trees (may be another filesystem).
concurrency_round() {
	local label=$1 src_root=$2 n=$CONC_WORKERS round i pids rcs ok detail
	local gate="$src_root/gate" got want entry info_path
	ok=true; detail=""
	for ((round = 1; round <= CONC_ROUNDS; round++)); do
		reset_trash
		"$REAL_RM" -rf "$src_root/w" "$gate"
		for ((i = 1; i <= n; i++)); do
			mkdir -p "$src_root/w/$i/same dir"
			printf 'file-%d\n' "$i" >"$src_root/w/$i/same.txt"
			printf 'dir-%d\n' "$i" >"$src_root/w/$i/same dir/inner"
		done
		pids=()
		for ((i = 1; i <= n; i++)); do
			# Busy-wait on a gate file (no sleeps) so all workers start together.
			env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$ACTIVE_PATH" "${HOSTILE_FUNCS[@]}" bash -c '
				until [[ -e $1 ]]; do :; done
				exec rm-safe -rf "$2/same.txt" "$2/same dir"
			' _ "$gate" "$src_root/w/$i" >"$src_root/out.$i" 2>&1 &
			pids+=($!)
		done
		: >"$gate"
		rcs=""
		for ((i = 0; i < n; i++)); do
			wait "${pids[$i]}" || rcs+=" worker$((i + 1))=$?"
		done
		if [[ -n $rcs ]]; then
			ok=false; detail="round $round nonzero exits:$rcs; $(cat "$src_root"/out.* 2>/dev/null | sort -u | head -n 3)"
			break
		fi
		want=$(for ((i = 1; i <= n; i++)); do printf 'dir-%d\nfile-%d\n' "$i" "$i"; done | sort)
		got=$(for entry in "$TRASH_FILES"/*; do
			if [[ -d $entry ]]; then cat "$entry/inner"; else cat "$entry"; fi
		done 2>/dev/null | sort)
		if [[ $got != "$want" ]]; then
			ok=false; detail="round $round payloads lost/merged ($(printf '%s\n' "$got" | grep -c .) of $((2 * n)) recovered)"
			break
		fi
		for entry in "$TRASH_FILES"/*; do
			info_path="$TRASH_INFO/$(basename "$entry").trashinfo"
			if ! grep -Eq '^Path=.*/w/[0-9]+/same(\.txt|%20dir)$' "$info_path" 2>/dev/null; then
				ok=false; detail="round $round entry $(basename "$entry") lacks a matching .trashinfo"
				break 2
			fi
		done
		if [[ -n $(find "$TRASH_BASE" -maxdepth 1 -name '.rm-safe-staging.*' 2>/dev/null) ]]; then
			ok=false; detail="round $round left staging directories in the Trash: $(find "$TRASH_BASE" -maxdepth 2 -path '*/.rm-safe-staging.*' 2>/dev/null | head -n 4 | tr '\n' ' ')"
			break
		fi
		got=$(read_all_logs | awk -F'\t' '$3=="TRASH_MANUAL"' | grep -c .)
		if [[ $got -ne $((2 * n)) ]]; then
			ok=false; detail="round $round has $got TRASH_MANUAL undo records, want $((2 * n))"
			break
		fi
		if [[ -n $(find "$src_root/w" -mindepth 2 2>/dev/null) ]]; then
			ok=false; detail="round $round left sources behind"
			break
		fi
	done
	((tests++))
	if [[ $ok == true ]]; then
		echo "OK concurrent trashing is collision-free ($label)"
	else
		echo "FAIL concurrent trashing collided ($label): $detail" >&2
		((fails++))
	fi
}

# Test: a foreign Trash occupant is never replaced.
# Something outside the XDG protocol (no .trashinfo) already holds the plain
# basename in Trash/files. Placement must refuse that name atomically, release
# its reservation, and land the item under another name with metadata.
reset_trash
((tests++))
printf 'foreign\n' >"$TRASH_FILES/occupied.txt"
printf 'ours\n' >"$WORK_DIR/occupied.txt"
run_cmd "$WORK_DIR/occupied.txt"
occ_entry=$(grep -lx 'ours' "$TRASH_FILES"/* 2>/dev/null | head -n 1)
if [[ $RM_RC -eq 0 && $(cat "$TRASH_FILES/occupied.txt") == foreign \
	&& -n $occ_entry && $occ_entry != "$TRASH_FILES/occupied.txt" \
	&& -f "$TRASH_INFO/$(basename "$occ_entry").trashinfo" \
	&& ! -e "$TRASH_INFO/occupied.txt.trashinfo" && ! -e "$WORK_DIR/occupied.txt" ]]; then
	echo "OK foreign Trash occupant is preserved, item placed under a new name"
else
	echo "FAIL foreign Trash occupant handling (rc=$RM_RC entry=${occ_entry:-<none>})" >&2
	printf '%s\n' "$RM_ERR" >&2
	((fails++))
fi

# --undo onto an occupied target must refuse, never replace.
# The restore is a single no-replace rename (no exists-check first), so this
# deterministic case and the check-then-move race are one and the same code
# path: whatever occupies the target, created early or mid-restore, survives,
# and the item stays in the Trash with its .trashinfo.
# $1 = label, $2 = parent dir, $3 = file|dir
undo_occupied_case() {
	local label=$1 parent=$2 kind=$3 target entry ok=true detail=""
	local out err rc trash_rc
	target="$parent/undo-occupied-$kind"
	reset_trash
	"$REAL_RM" -rf "$target"
	if [[ $kind == dir ]]; then mkdir -p "$target"; echo old >"$target/inner"; else echo old >"$target"; fi
	capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$ACTIVE_PATH" "${HOSTILE_FUNCS[@]}" rm-safe -r "$target"
	trash_rc=$rc
	# The recreated occupant: an EMPTY dir is the sharp case, because rename(2)
	# silently replaces an empty directory.
	if [[ $kind == dir ]]; then mkdir "$target"; else echo new >"$target"; fi
	capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$ACTIVE_PATH" "${HOSTILE_FUNCS[@]}" rm-safe --undo
	entry=$(find "$TRASH_FILES" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)
	if [[ $trash_rc -ne 0 ]]; then
		ok=false; detail="trash step failed rc=$trash_rc"
	elif [[ $rc -eq 0 ]]; then
		ok=false; detail="undo exited 0 onto an occupied target"
	elif [[ $kind == dir && ( ! -d $target || -n $(ls -A "$target") ) ]]; then
		ok=false; detail="occupant dir was replaced or filled"
	elif [[ $kind == file && $(cat "$target" 2>/dev/null) != new ]]; then
		ok=false; detail="occupant file was overwritten"
	elif [[ -z $entry ]]; then
		ok=false; detail="trashed item vanished from the Trash"
	elif [[ $kind == dir && $(cat "$entry/inner" 2>/dev/null) != old ]] || [[ $kind == file && $(cat "$entry" 2>/dev/null) != old ]]; then
		ok=false; detail="trashed payload damaged"
	elif [[ ! -f "$TRASH_INFO/$(basename "$entry").trashinfo" ]]; then
		ok=false; detail="trashinfo removed although restore failed"
	elif read_all_logs | awk -F'\t' '$3 ~ /TRASH_RESTORE$/' | grep -q .; then
		ok=false; detail="TRASH_RESTORE logged for a refused restore"
	elif ! printf '%s' "$err" | grep -qF "Restore target already exists"; then
		ok=false; detail="missing refusal message: $err"
	elif [[ -n $(find "$parent" -maxdepth 1 -name '.rm-safe-*' 2>/dev/null) ]]; then
		ok=false; detail="left staging directories beside the target"
	fi
	"$REAL_RM" -rf "$target"
	((tests++))
	if [[ $ok == true ]]; then
		echo "OK undo refuses an occupied $kind target ($label)"
	else
		echo "FAIL undo onto occupied $kind target ($label): $detail" >&2
		((fails++))
	fi
}

# Successful --undo leaves nothing behind: payload restored, Trash entry and
# .trashinfo gone, TRASH_RESTORE logged, no staging debris.
# $1 = label, $2 = parent dir, $3 = file|dir
undo_restores_case() {
	local label=$1 parent=$2 kind=$3 target ok=true detail="" out err rc
	target="$parent/undo-restores-$kind"
	reset_trash
	"$REAL_RM" -rf "$target"
	if [[ $kind == dir ]]; then mkdir -p "$target"; echo old >"$target/inner"; else echo old >"$target"; fi
	capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$ACTIVE_PATH" "${HOSTILE_FUNCS[@]}" rm-safe -r "$target"
	capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$ACTIVE_PATH" "${HOSTILE_FUNCS[@]}" rm-safe --undo
	if [[ $rc -ne 0 ]]; then
		ok=false; detail="undo rc=$rc: $err"
	elif [[ $kind == dir && $(cat "$target/inner" 2>/dev/null) != old ]] || [[ $kind == file && $(cat "$target" 2>/dev/null) != old ]]; then
		ok=false; detail="payload not restored"
	elif [[ -n $(find "$TRASH_FILES" "$TRASH_INFO" -mindepth 1 2>/dev/null) ]]; then
		ok=false; detail="Trash entry or trashinfo left behind"
	elif ! read_all_logs | awk -F'\t' '$3 ~ /TRASH_RESTORE$/' | grep -q .; then
		ok=false; detail="TRASH_RESTORE not logged"
	elif [[ -n $(find "$parent" "$TRASH_BASE" -maxdepth 1 -name '.rm-safe-*' 2>/dev/null) ]]; then
		ok=false; detail="left staging directories"
	fi
	"$REAL_RM" -rf "$target"
	((tests++))
	if [[ $ok == true ]]; then
		echo "OK undo restores a $kind ($label)"
	else
		echo "FAIL undo restore of $kind ($label): $detail" >&2
		((fails++))
	fi
}

CONC_WORKERS=16
CONC_ROUNDS=3
CONC_SAME_FS="$TEST_DIR/conc"
mkdir -p "$CONC_SAME_FS"

# Cross-device parent: sources on a different mount than the Trash, so a move
# cannot be a single rename(2). /dev/shm is a separate tmpfs on Linux.
CONC_XDEV=""
if [[ -d /dev/shm && -w /dev/shm ]]; then
	CONC_XDEV=$(mktemp -d /dev/shm/rm-safe-conc.XXXXXX 2>/dev/null || true)
fi
if [[ -n $CONC_XDEV ]] && [[ $(stat -c %d "$CONC_XDEV" 2>/dev/null) == "$(stat -c %d "$TEST_DIR" 2>/dev/null)" ]]; then
	"$REAL_RM" -rf "$CONC_XDEV"; CONC_XDEV=""
fi

# Every placement/restore invariant, under the current $ACTIVE_PATH.
atomicity_suite() { # $1 = flavor label
	local flavor=$1 kind
	concurrency_round "same filesystem, $flavor" "$CONC_SAME_FS"
	for kind in file dir; do
		undo_occupied_case "same filesystem, $flavor" "$CONC_SAME_FS" "$kind"
		undo_restores_case "same filesystem, $flavor" "$CONC_SAME_FS" "$kind"
	done
	if [[ -n $CONC_XDEV ]]; then
		concurrency_round "cross-device, $flavor" "$CONC_XDEV"
		for kind in file dir; do
			undo_occupied_case "cross-device, $flavor" "$CONC_XDEV" "$kind"
			undo_restores_case "cross-device, $flavor" "$CONC_XDEV" "$kind"
		done
	else
		skip_test "cross-device atomicity ($flavor)" "no writable mount distinct from \$TMPDIR"
	fi
}

# Exported shell functions shadowing the tools rm-safe shells out to. /bin/sh
# is often bash, which imports these, so a bare `cp`/`mv`/`ln` would run them.
# rm-safe must invoke real executables by path and never notice.
HOSTILE_FUNCS=()
for fn in cp mv ln rm rmdir readlink; do
	HOSTILE_FUNCS+=("BASH_FUNC_${fn}%%=() { return 97; }")
done

ACTIVE_PATH=$PATH_BASE
atomicity_suite "GNU mv"

# Same invariants with a BSD-like mv: no --version, -n, -T or --update. This
# forces the bash impl off GNU mv's RENAME_NOREPLACE onto its posix mode
# (ln / ln -s / plain directory mv), and proves the luajit impl never relies
# on GNU mv semantics either.
BSD_MV_DIR="$TEST_DIR/bsd-mv"
mkdir -p "$BSD_MV_DIR"
GNU_MV=$(PATH="$PATH_BASE" type -P mv)
for mv_name in mv gmv; do
	cat >"$BSD_MV_DIR/$mv_name" <<BSDMV
#!/bin/sh
for a in "\$@"; do
	case \$a in
		--) break ;;
		--version|-n|-T|--no-clobber|--update*|--no-target-directory) echo "mv: illegal option \$a" >&2; exit 64 ;;
	esac
done
exec "$GNU_MV" "\$@"
BSDMV
	chmod +x "$BSD_MV_DIR/$mv_name"
done
ACTIVE_PATH="$BSD_MV_DIR:$PATH_BASE"
atomicity_suite "BSD mv"

ACTIVE_PATH=$PATH_BASE

[[ -n $CONC_XDEV ]] && "$REAL_RM" -rf "$CONC_XDEV"
echo "=== Test Summary ==="
echo "Passed: $((tests - fails - skips))"
echo "Skipped: $skips" >&2
echo "Failed: $fails" >&2
exit $fails
