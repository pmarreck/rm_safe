#!/usr/bin/env bash

# Test the rm override shim

fails=0
tests=0

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
RM_SHIM="$REPO_ROOT/bin/rm"
RMDIR_SHIM="$REPO_ROOT/bin/rmdir"
FIND_SHIM="$REPO_ROOT/bin/find"
TRUNCATE_SHIM="$REPO_ROOT/bin/truncate"
SELF="$RM_SHIM"

test_dir=$(mktemp -d "${TMPDIR:-/tmp}/rm-override-test.XXXXXX")
# Resolve a real rm the same way the other suites do: a bare `rm` here can
# resolve to an rm-safe shim, which would move fixtures to the trash instead of
# deleting them -- the suite would slowly fill the developer's Trash.
REAL_RM=$([ -x /bin/rm ] && echo /bin/rm || command -v rm || echo rm)
trap '"$REAL_RM" -rf "$test_dir"' EXIT

# PATH must still contain bash/dirname/etc for the shim's shebang; avoid rm-safe presence
PATH_SAFE="/usr/local/bin:/usr/bin:/bin"
[[ -d /run/current-system/sw/bin ]] && PATH_SAFE="/run/current-system/sw/bin:$PATH_SAFE"

# A bin dir with a FAKE luajit, so the shim's luajit fast-path fires regardless
# of whether this machine actually has luajit installed.
LUAJIT_STUB_DIR="$test_dir/with_luajit"
mkdir -p "$LUAJIT_STUB_DIR"
printf '#!/bin/sh\nexit 0\n' >"$LUAJIT_STUB_DIR/luajit"
chmod +x "$LUAJIT_STUB_DIR/luajit"

# A PATH guaranteed to have no luajit. Filtering PATH_SAFE per-directory is too
# coarse: on NixOS bash and luajit share /run/current-system/sw/bin, so dropping
# that directory also drops the `bash` the shim's `#!/usr/bin/env bash` needs.
# The shim then never executes at all and the fallback assertions below fail for
# a reason that has nothing to do with the behavior under test. Build a
# symlink-only overlay instead: the tools the shim needs, and no luajit.
NO_LUAJIT_DIR="$test_dir/no_luajit"
mkdir -p "$NO_LUAJIT_DIR"
for _c in bash dirname find truncate stat; do
	_p=$(PATH="$PATH_SAFE" type -P "$_c" 2>/dev/null)
	[[ -n $_p ]] && ln -sf -- "$_p" "$NO_LUAJIT_DIR/$_c"
done
NO_LUAJIT_PATH="$NO_LUAJIT_DIR"

# helper: run command, capture stdout/stderr, exit status
run_cmd() {
	local cmd="$1"; shift
	local outfile="$test_dir/out"; local errfile="$test_dir/err"
	( "$cmd" "$@" ) >"$outfile" 2>"$errfile"
	echo "$outfile" "$errfile" $?
}

# Test 1: Uses rm-safe when present
((tests++))
rm_safe_fake="$test_dir/rm-safe"
cat >"$rm_safe_fake" <<'EOF'
#!/bin/sh
echo "rm-safe invoked" >"$TMPDIR/rm-safe-called"
EOF
chmod +x "$rm_safe_fake"

TMPDIR="$test_dir" PATH="$test_dir:$LUAJIT_STUB_DIR:$PATH_SAFE" REAL_RM="/bin/rm" bash -c "$RM_SHIM >/dev/null" 2>/dev/null

if [[ -f "$test_dir/rm-safe-called" ]]; then
	echo "✓ rm-safe invoked when available"
else
	echo "✗ rm-safe not invoked when available" >&2
	((fails++))
fi

# Test 2: Fails closed when rm-safe AND rm-safe.bash are both missing.
# Use a shim copy isolated in its own dir (no bash impl sibling), so the
# final branch must leave the target alone rather than reach REAL_RM.
((tests++))
shim2_dir="$test_dir/shim2"
mkdir -p "$shim2_dir"
real_rm_fake="$test_dir/real-rm"
cat >"$real_rm_fake" <<'EOF'
#!/bin/sh
echo "real rm used" >"$TMPDIR/real-rm-called"
EOF
chmod +x "$real_rm_fake"
cp "$RM_SHIM" "$shim2_dir/rm"
chmod +x "$shim2_dir/rm"

mkdir -p "$test_dir/empty"
missing_safe_target="$test_dir/missing-safe-target"
printf 'keep\n' >"$missing_safe_target"

TMPDIR="$test_dir" REAL_RM="$real_rm_fake" PATH="$test_dir/empty:$PATH_SAFE" "$shim2_dir/rm" "$missing_safe_target" \
	>/dev/null 2>"$test_dir/stderr.txt"
missing_safe_rc=$?

if [[ $missing_safe_rc -ne 0 && -f "$missing_safe_target" && ! -f "$test_dir/real-rm-called" ]]; then
	echo "✓ rm shadow refuses a permanent-deletion fallback"
else
	echo "✗ rm shadow fell back to permanent deletion" >&2
	((fails++))
fi

if grep -q "refusing to permanently delete" "$test_dir/stderr.txt"; then
	echo "✓ Refusal explains the missing safe implementation"
else
	echo "✗ Refusal message missing when rm-safe is absent" >&2
	((fails++))
fi

# Test 3: Guard against recursion when rm-safe on PATH points to this shim
# Put a symlink named "rm-safe" pointing to the shim itself into a test dir;
# the shim should detect the loop and warn.
((tests++))
recur_dir="$test_dir/recur"
mkdir -p "$recur_dir"
cp "$RM_SHIM" "$recur_dir/rm"
chmod +x "$recur_dir/rm"
# rm-safe on PATH resolves to the same file as this shim copy → recursion guard fires.
ln -sf "$recur_dir/rm" "$recur_dir/rm-safe"
TMPDIR="$test_dir" REAL_RM="$real_rm_fake" PATH="$recur_dir:$LUAJIT_STUB_DIR:$PATH_SAFE" "$recur_dir/rm" >/dev/null 2>"$test_dir/stderr2.txt" || true

if grep -q "recursive" "$test_dir/stderr2.txt"; then
	echo "✓ Recursion detected and warned"
else
	echo "✗ Recursion guard did not warn" >&2
	((fails++))
fi

# Test 4: RM_SAFE_BIN override takes precedence
((tests++))
override_fake="$test_dir/override-impl"
cat >"$override_fake" <<'EOF'
#!/bin/sh
echo "override invoked" >"$TMPDIR/override-called"
EOF
chmod +x "$override_fake"
TMPDIR="$test_dir" PATH="$test_dir:$PATH_SAFE" RM_SAFE_BIN="$override_fake" "$RM_SHIM" >/dev/null 2>&1
if [[ -f "$test_dir/override-called" ]]; then
	echo "✓ RM_SAFE_BIN override is honored"
else
	echo "✗ RM_SAFE_BIN override not honored" >&2
	((fails++))
fi

# Test 5: luajit absent -> bash impl used + warning; RM_SAFE_QUIET silences it
((tests++))
bash_impl_fake="$test_dir/rm-safe.bash"
cat >"$bash_impl_fake" <<'EOF'
#!/bin/sh
echo "bash impl invoked" >"$TMPDIR/bash-impl-called"
EOF
chmod +x "$bash_impl_fake"
# Shim resolves its sibling rm-safe.bash relative to its own dir, so point a
# copy of the shim next to the fake bash impl, with NO luajit on PATH.
cp "$RM_SHIM" "$test_dir/rm"
chmod +x "$test_dir/rm"
mkdir -p "$test_dir/empty"
TMPDIR="$test_dir" PATH="$test_dir/empty:$NO_LUAJIT_PATH" "$test_dir/rm" foo >/dev/null 2>"$test_dir/warn.txt"
if [[ -f "$test_dir/bash-impl-called" ]] && grep -q "luajit not found" "$test_dir/warn.txt"; then
	echo "✓ Falls back to bash impl with warning when luajit absent"
else
	echo "✗ bash fallback/warning failed" >&2
	((fails++))
fi
rm -f "$test_dir/bash-impl-called"
TMPDIR="$test_dir" RM_SAFE_QUIET=1 PATH="$test_dir/empty:$NO_LUAJIT_PATH" "$test_dir/rm" foo >/dev/null 2>"$test_dir/warn2.txt"
if [[ -f "$test_dir/bash-impl-called" ]] && ! grep -q "luajit not found" "$test_dir/warn2.txt"; then
	echo "✓ RM_SAFE_QUIET suppresses the warning"
else
	echo "✗ RM_SAFE_QUIET did not suppress warning" >&2
	((fails++))
fi

# Test 6: rmdir shadow moves an empty directory to Trash without deleting it.
((tests++))
rmdir_empty="$test_dir/rmdir empty"
rmdir_xdg="$test_dir/rmdir-xdg"
mkdir -p "$rmdir_empty" "$rmdir_xdg"
XDG_DATA_HOME="$rmdir_xdg" RM_SAFE_BIN="$REPO_ROOT/bin/rm-safe.bash" \
	RM_SAFE_QUIET=1 PATH="$PATH_SAFE" "$RMDIR_SHIM" "$rmdir_empty" \
	>"$test_dir/rmdir-out.txt" 2>"$test_dir/rmdir-err.txt"
if [[ ! -e "$rmdir_empty" && -d "$rmdir_xdg/Trash/files/rmdir empty" ]]; then
	echo "✓ rmdir shadow moves an empty directory to Trash"
else
	echo "✗ rmdir shadow did not move an empty directory to Trash" >&2
	((fails++))
fi

# Test 7: rmdir must retain its non-recursive boundary for non-empty directories.
((tests++))
rmdir_nonempty="$test_dir/rmdir nonempty"
mkdir -p "$rmdir_nonempty"
printf 'keep\n' >"$rmdir_nonempty/child"
XDG_DATA_HOME="$rmdir_xdg" RM_SAFE_BIN="$REPO_ROOT/bin/rm-safe.bash" \
	RM_SAFE_QUIET=1 PATH="$PATH_SAFE" "$RMDIR_SHIM" "$rmdir_nonempty" \
	>"$test_dir/rmdir-nonempty-out.txt" 2>"$test_dir/rmdir-nonempty-err.txt"
rmdir_nonempty_rc=$?
if [[ $rmdir_nonempty_rc -ne 0 && -f "$rmdir_nonempty/child" \
	&& ! -e "$rmdir_xdg/Trash/files/rmdir nonempty" \
	&& $(grep -c "Directory not empty" "$test_dir/rmdir-nonempty-err.txt") -eq 1 ]]; then
	echo "✓ rmdir shadow rejects a non-empty directory"
else
	echo "✗ rmdir shadow accepted a non-empty directory" >&2
	((fails++))
fi

# Test 8: a partial install must refuse rather than fall back to system rmdir.
((tests++))
isolated_rmdir_dir="$test_dir/rmdir-isolated"
isolated_rmdir="$isolated_rmdir_dir/rmdir"
rmdir_no_safe="$test_dir/rmdir no safe"
mkdir -p "$isolated_rmdir_dir"
cp "$RMDIR_SHIM" "$isolated_rmdir"
chmod +x "$isolated_rmdir"
mkdir -p "$rmdir_no_safe"
TMPDIR="$test_dir" PATH="$NO_LUAJIT_PATH" "$isolated_rmdir" "$rmdir_no_safe" \
	>"$test_dir/rmdir-no-safe-out.txt" 2>"$test_dir/rmdir-no-safe-err.txt"
rmdir_no_safe_rc=$?
if [[ $rmdir_no_safe_rc -ne 0 && -d "$rmdir_no_safe" \
	&& $(grep -c "refusing to permanently delete" "$test_dir/rmdir-no-safe-err.txt") -eq 1 ]]; then
	echo "✓ rmdir shadow refuses a permanent-deletion fallback"
else
	echo "✗ rmdir shadow fell back to permanent deletion" >&2
	((fails++))
fi

# Test 9: inherited shell functions must not replace rmdir's find executable.
((tests++))
hostile_find_env="$test_dir/hostile-find.bashenv"
hostile_rmdir_safe="$test_dir/hostile-rmdir-safe"
rmdir_hostile="$test_dir/rmdir hostile find"
cat >"$hostile_find_env" <<'EOF'
find() { return 127; }
EOF
cat >"$hostile_rmdir_safe" <<'EOF'
#!/bin/sh
printf 'called\n' >"$TMPDIR/rmdir-hostile-called"
EOF
chmod +x "$hostile_rmdir_safe"
mkdir -p "$rmdir_hostile"
TMPDIR="$test_dir" BASH_ENV="$hostile_find_env" RM_SAFE_BIN="$hostile_rmdir_safe" \
	PATH="$NO_LUAJIT_PATH" "$RMDIR_SHIM" "$rmdir_hostile" \
	>"$test_dir/rmdir-hostile-out.txt" 2>"$test_dir/rmdir-hostile-err.txt"
if [[ -f "$test_dir/rmdir-hostile-called" ]]; then
	echo "✓ rmdir shadow ignores an inherited find function"
else
	echo "✗ rmdir shadow obeyed an inherited find function" >&2
	((fails++))
fi

# Test 10: find shadow maps a terminal -delete onto the safe per-path action.
((tests++))
find_work="$test_dir/find work"
find_xdg="$test_dir/find-xdg"
find_purge="$find_work/purge
file"
find_keep="$find_work/keep"
mkdir -p "$find_work" "$find_xdg"
printf 'trash me\n' >"$find_purge"
printf 'keep me\n' >"$find_keep"
real_find=$(type -P find)
XDG_DATA_HOME="$find_xdg" RM_SAFE_BIN="$REPO_ROOT/bin/rm-safe.bash" \
	RM_SAFE_QUIET=1 REAL_FIND="$real_find" PATH="$PATH_SAFE" \
	"$FIND_SHIM" "$find_work" -type f -name 'purge*' -delete \
	>"$test_dir/find-out.txt" 2>"$test_dir/find-err.txt"
find_delete_rc=$?
if [[ $find_delete_rc -eq 0 && ! -e "$find_purge" && -f "$find_keep" \
	&& -f "$find_xdg/Trash/files/${find_purge##*/}" ]]; then
	echo "✓ find shadow trashes a terminal -delete match"
else
	echo "✗ find shadow did not safely emulate a terminal -delete" >&2
	((fails++))
fi

# Test 11: every unsupported -delete expression shape is rejected before real find runs.
((tests++))
find_complex="$test_dir/find complex"
mkdir -p "$find_complex"
printf 'keep\n' >"$find_complex/keep"
find_reject_failures=0
check_find_reject() {
	local label=$1
	shift
	REAL_FIND="$real_find" PATH="$PATH_SAFE" "$FIND_SHIM" "$find_complex" "$@" \
		>"$test_dir/find-reject-$label-out.txt" 2>"$test_dir/find-reject-$label-err.txt"
	local rc=$?
	if [[ $rc -eq 0 || ! -f "$find_complex/keep" \
		|| $(grep -c "cannot safely emulate -delete" "$test_dir/find-reject-$label-err.txt") -ne 1 ]]; then
		echo "✗ find shadow accepted $label" >&2
		((find_reject_failures++))
	fi
}
check_find_reject boolean-or -delete -o -print
check_find_reject boolean-and -type f -a -delete
check_find_reject boolean-not ! -name no-match -delete
check_find_reject prune -prune -delete
check_find_reject duplicate -delete -delete
check_find_reject non-terminal -delete -type f
check_find_reject unknown-primary -samefile "$find_complex/keep" -delete
if [[ $find_reject_failures -eq 0 ]]; then
	echo "✓ find shadow rejects all unsupported -delete expression shapes"
else
	echo "✗ find shadow accepted an unsupported -delete expression shape" >&2
	((fails++))
fi

# Test 12: an undeletable matched directory makes the whole find command fail.
((tests++))
find_dirs="$test_dir/find dirs"
find_empty_dir="$find_dirs/empty"
find_nonempty_dir="$find_dirs/nonempty"
mkdir -p "$find_empty_dir" "$find_nonempty_dir"
printf 'keep\n' >"$find_nonempty_dir/child"
XDG_DATA_HOME="$find_xdg" RM_SAFE_BIN="$REPO_ROOT/bin/rm-safe.bash" \
	RM_SAFE_QUIET=1 REAL_FIND="$real_find" PATH="$PATH_SAFE" \
	"$FIND_SHIM" "$find_dirs" -type d -delete \
	>"$test_dir/find-dirs-out.txt" 2>"$test_dir/find-dirs-err.txt"
find_dirs_rc=$?
if [[ $find_dirs_rc -ne 0 && ! -e "$find_empty_dir" \
	&& -f "$find_nonempty_dir/child" \
	&& -d "$find_xdg/Trash/files/empty" ]]; then
	echo "✓ find shadow reports a failed safe deletion"
else
	echo "✗ find shadow hid a failed safe deletion" >&2
	((fails++))
fi

# Test 13: a search without -delete is delegated to real find unchanged.
((tests++))
find_passthrough="$test_dir/find passthrough"
mkdir -p "$find_passthrough"
printf 'keep\n' >"$find_passthrough/keep"
REAL_FIND="$real_find" PATH="$PATH_SAFE" "$FIND_SHIM" "$find_passthrough" -type f -print \
	>"$test_dir/find-passthrough-out.txt" 2>"$test_dir/find-passthrough-err.txt"
find_passthrough_rc=$?
find_passthrough_out=$(cat "$test_dir/find-passthrough-out.txt")
if [[ $find_passthrough_rc -eq 0 && $find_passthrough_out == "$find_passthrough/keep" \
	&& -f "$find_passthrough/keep" ]]; then
	echo "✓ find shadow delegates ordinary searches unchanged"
else
	echo "✗ find shadow changed an ordinary search" >&2
	((fails++))
fi

# Test 14: a literal -delete used as a predicate argument is not an action.
((tests++))
find_argument="$test_dir/find argument"
mkdir -p "$find_argument"
printf 'pattern\n' >"$find_argument/-delete"
printf 'must survive\n' >"$find_argument/-depth"
REAL_FIND="$real_find" PATH="$PATH_SAFE" "$FIND_SHIM" "$find_argument" -name -delete \
	>"$test_dir/find-argument-out.txt" 2>"$test_dir/find-argument-err.txt"
find_argument_rc=$?
find_argument_out=$(cat "$test_dir/find-argument-out.txt")
if [[ $find_argument_rc -eq 0 && $find_argument_out == "$find_argument/-delete" \
	&& -f "$find_argument/-delete" && -f "$find_argument/-depth" ]]; then
	echo "✓ find shadow does not mistake a predicate argument for -delete"
else
	echo "✗ find shadow mistook a predicate argument for -delete" >&2
	((fails++))
fi

# Test 15: without REAL_FIND, a PATH entry after this shim supplies real find.
((tests++))
find_resolver="$test_dir/find resolver"
mkdir -p "$find_resolver"
printf 'keep\n' >"$find_resolver/keep"
REAL_FIND= PATH="$REPO_ROOT/bin:$NO_LUAJIT_PATH" "$FIND_SHIM" "$find_resolver" -type f -print \
	>"$test_dir/find-resolver-out.txt" 2>"$test_dir/find-resolver-err.txt"
find_resolver_rc=$?
find_resolver_out=$(cat "$test_dir/find-resolver-out.txt")
if [[ $find_resolver_rc -eq 0 && $find_resolver_out == "$find_resolver/keep" \
	&& -f "$find_resolver/keep" ]]; then
	echo "✓ find shadow resolves real find from a later PATH entry"
else
	echo "✗ find shadow failed to resolve real find from PATH" >&2
	((fails++))
fi

# Test 16: a shrinking resize reports its loss and needs --confirm.
((tests++))
truncate_target="$test_dir/truncate target"
printf '0123456789' >"$truncate_target"
real_truncate=$(type -P truncate)
REAL_TRUNCATE="$real_truncate" "$TRUNCATE_SHIM" -s 4 "$truncate_target" \
	>"$test_dir/truncate-out.txt" 2>"$test_dir/truncate-err.txt"
truncate_guard_rc=$?
truncate_size=$(wc -c <"$truncate_target")
if [[ $truncate_guard_rc -ne 0 && $truncate_size -eq 10 \
	&& $(grep -c "confirmation required" "$test_dir/truncate-err.txt") -eq 1 \
	&& $(grep -c "current size: 10 bytes" "$test_dir/truncate-err.txt") -eq 1 \
	&& $(grep -c "requested size: 4 bytes" "$test_dir/truncate-err.txt") -eq 1 \
	&& $(grep -c "data discarded: 6 bytes" "$test_dir/truncate-err.txt") -eq 1 \
	&& $(grep -c -- "--confirm" "$test_dir/truncate-err.txt") -eq 1 ]]; then
	echo "✓ truncate shadow forecasts shrinking data loss and requires confirmation"
else
	echo "✗ truncate shadow did not guard a shrinking resize" >&2
	((fails++))
fi

# Test 17: --confirm performs a shrink, while a growth remains friction-free.
((tests++))
REAL_TRUNCATE="$real_truncate" "$TRUNCATE_SHIM" --confirm -s 4 "$truncate_target" \
	>"$test_dir/truncate-confirm-out.txt" 2>"$test_dir/truncate-confirm-err.txt"
truncate_confirm_rc=$?
truncate_confirm_size=$(wc -c <"$truncate_target")
truncate_growth="$test_dir/truncate growth"
printf '0123' >"$truncate_growth"
REAL_TRUNCATE="$real_truncate" "$TRUNCATE_SHIM" -s 10 "$truncate_growth" \
	>"$test_dir/truncate-growth-out.txt" 2>"$test_dir/truncate-growth-err.txt"
truncate_growth_rc=$?
truncate_growth_size=$(wc -c <"$truncate_growth")
if [[ $truncate_confirm_rc -eq 0 && $truncate_confirm_size -eq 4 \
	&& $truncate_growth_rc -eq 0 && $truncate_growth_size -eq 10 ]]; then
	echo "✓ truncate shadow permits confirmed shrinkage and ordinary growth"
else
	echo "✗ truncate shadow did not preserve confirmed/growing behavior" >&2
	((fails++))
fi

# Test 18: relative shrinkage gets the same exact preflight forecast.
((tests++))
truncate_relative="$test_dir/truncate relative"
printf '0123456789' >"$truncate_relative"
REAL_TRUNCATE="$real_truncate" "$TRUNCATE_SHIM" -s -3 "$truncate_relative" \
	>"$test_dir/truncate-relative-out.txt" 2>"$test_dir/truncate-relative-err.txt"
truncate_relative_rc=$?
truncate_relative_size=$(wc -c <"$truncate_relative")
if [[ $truncate_relative_rc -ne 0 && $truncate_relative_size -eq 10 \
	&& $(grep -c "requested size: 7 bytes" "$test_dir/truncate-relative-err.txt") -eq 1 \
	&& $(grep -c "data discarded: 3 bytes" "$test_dir/truncate-relative-err.txt") -eq 1 ]]; then
	echo "✓ truncate shadow forecasts relative shrinkage exactly"
else
	echo "✗ truncate shadow did not forecast relative shrinkage exactly" >&2
	((fails++))
fi

# Test 19: reference-sized shrinkage reports the actual reference result.
((tests++))
truncate_reference="$test_dir/truncate reference"
truncate_reference_target="$test_dir/truncate reference target"
printf '012' >"$truncate_reference"
printf '0123456789' >"$truncate_reference_target"
REAL_TRUNCATE="$real_truncate" "$TRUNCATE_SHIM" --reference "$truncate_reference" "$truncate_reference_target" \
	>"$test_dir/truncate-reference-out.txt" 2>"$test_dir/truncate-reference-err.txt"
truncate_reference_rc=$?
truncate_reference_size=$(wc -c <"$truncate_reference_target")
if [[ $truncate_reference_rc -ne 0 && $truncate_reference_size -eq 10 \
	&& $(grep -c "requested size: 3 bytes" "$test_dir/truncate-reference-err.txt") -eq 1 \
	&& $(grep -c "data discarded: 7 bytes" "$test_dir/truncate-reference-err.txt") -eq 1 ]]; then
	echo "✓ truncate shadow forecasts reference-sized shrinkage exactly"
else
	echo "✗ truncate shadow did not forecast reference-sized shrinkage" >&2
	((fails++))
fi

# Test 20: I/O block mode compares the effective byte size, not its token.
((tests++))
truncate_blocks="$test_dir/truncate blocks"
printf '0123456789' >"$truncate_blocks"
REAL_TRUNCATE="$real_truncate" "$TRUNCATE_SHIM" --io-blocks --size 0 "$truncate_blocks" \
	>"$test_dir/truncate-blocks-out.txt" 2>"$test_dir/truncate-blocks-err.txt"
truncate_blocks_rc=$?
truncate_blocks_size=$(wc -c <"$truncate_blocks")
if [[ $truncate_blocks_rc -ne 0 && $truncate_blocks_size -eq 10 \
	&& $(grep -c "requested size: 0 bytes" "$test_dir/truncate-blocks-err.txt") -eq 1 \
	&& $(grep -c "data discarded: 10 bytes" "$test_dir/truncate-blocks-err.txt") -eq 1 ]]; then
	echo "✓ truncate shadow forecasts I/O-block shrinkage in bytes"
else
	echo "✗ truncate shadow did not forecast I/O-block shrinkage" >&2
	((fails++))
fi

# Test 21: I/O block multipliers apply before a relative adjustment.
((tests++))
truncate_relative_blocks="$test_dir/truncate relative blocks"
printf '0123456789' >"$truncate_relative_blocks"
REAL_TRUNCATE="$real_truncate" "$TRUNCATE_SHIM" --io-blocks --size -1 "$truncate_relative_blocks" \
	>"$test_dir/truncate-relative-blocks-out.txt" 2>"$test_dir/truncate-relative-blocks-err.txt"
truncate_relative_blocks_rc=$?
truncate_relative_blocks_size=$(wc -c <"$truncate_relative_blocks")
if [[ $truncate_relative_blocks_rc -ne 0 && $truncate_relative_blocks_size -eq 10 \
	&& $(grep -c "requested size: 0 bytes" "$test_dir/truncate-relative-blocks-err.txt") -eq 1 \
	&& $(grep -c "data discarded: 10 bytes" "$test_dir/truncate-relative-blocks-err.txt") -eq 1 ]]; then
	echo "✓ truncate shadow applies I/O blocks before relative shrinkage"
else
	echo "✗ truncate shadow misclassified relative I/O-block shrinkage" >&2
	((fails++))
fi

# Test 22: without REAL_TRUNCATE, a later PATH entry supplies the real tool.
((tests++))
truncate_resolver="$test_dir/truncate resolver"
printf '0123456789' >"$truncate_resolver"
REAL_TRUNCATE= PATH="$REPO_ROOT/bin:$NO_LUAJIT_PATH" "$TRUNCATE_SHIM" -s 4 "$truncate_resolver" \
	>"$test_dir/truncate-resolver-out.txt" 2>"$test_dir/truncate-resolver-err.txt"
truncate_resolver_rc=$?
truncate_resolver_size=$(wc -c <"$truncate_resolver")
if [[ $truncate_resolver_rc -ne 0 && $truncate_resolver_size -eq 10 \
	&& $(grep -c "data discarded: 6 bytes" "$test_dir/truncate-resolver-err.txt") -eq 1 ]]; then
	echo "✓ truncate shadow resolves real truncate from a later PATH entry"
else
	echo "✗ truncate shadow failed to resolve real truncate from PATH" >&2
	((fails++))
fi

# Test 23: --io-blocks does not reinterpret a reference file's byte size.
((tests++))
truncate_block_reference="$test_dir/truncate block reference"
truncate_block_reference_target="$test_dir/truncate block reference target"
printf '0' >"$truncate_block_reference"
printf '%0400d' 0 >"$truncate_block_reference_target"
REAL_TRUNCATE="$real_truncate" "$TRUNCATE_SHIM" --io-blocks --reference "$truncate_block_reference" "$truncate_block_reference_target" \
	>"$test_dir/truncate-block-reference-out.txt" 2>"$test_dir/truncate-block-reference-err.txt"
truncate_block_reference_rc=$?
truncate_block_reference_size=$(wc -c <"$truncate_block_reference_target")
if [[ $truncate_block_reference_rc -ne 0 && $truncate_block_reference_size -eq 400 \
	&& $(grep -c "requested size: 1 bytes" "$test_dir/truncate-block-reference-err.txt") -eq 1 \
	&& $(grep -c "data discarded: 399 bytes" "$test_dir/truncate-block-reference-err.txt") -eq 1 ]]; then
	echo "✓ truncate shadow leaves reference sizes in bytes under I/O-block mode"
else
	echo "✗ truncate shadow reinterpreted a reference size as I/O blocks" >&2
	((fails++))
fi

echo "=== Test Summary ==="
echo "Passed: $((tests - fails))"
echo "Failed: $fails" >&2
exit $fails
